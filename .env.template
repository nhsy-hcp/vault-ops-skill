# Copy to .env and fill in. Never commit .env.
export VAULT_ADDR=https://127.0.0.1:8210
# Host side of the container port mapping; must match VAULT_ADDR
export VAULT_HOST_IP=127.0.0.1
export VAULT_HOST_PORT=8210
export VAULT_CONTAINER_NAME=vault-primary
export VAULT_NETWORK=vault-ops
# DR secondary (replicates from the primary over the vault-ops network)
export VAULT_DR_ADDR=https://127.0.0.1:8220
export VAULT_DR_HOST_PORT=8220
export VAULT_DR_CONTAINER_NAME=vault-dr
export VAULT_SKIP_VERIFY=true
# Optional CA bundle instead of skip-verify:
# export VAULT_CACERT=.tmp/vault/tls/vault-ca.pem
export VAULT_TOKEN=root
export VAULT_LICENSE=
export CONTAINER_CLI=docker
export VAULT_IMAGE=docker.io/hashicorp/vault-enterprise:2.1.1-ent
