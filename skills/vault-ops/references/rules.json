    "VT-REPL-004": {
      "severity": "high",
      "category": "replication",
      "title": "Replication merkle tree reported corrupted"
    },
    "VT-REPL-005": {
      "severity": "info",
      "category": "replication",
      "title": "Performance replication paths filter in use"
