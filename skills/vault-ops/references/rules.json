    "VT-SNT-001": {
      "severity": "low",
      "category": "governance",
      "title": "Sentinel policy is advisory"
    },
    "VT-SNT-002": {
      "severity": "info",
      "category": "governance",
      "title": "Sentinel policy is overridable"
    },
    "VT-SNT-003": {
      "severity": "info",
      "category": "governance",
      "title": "EGP applies to every path"
    },
    "VT-SNT-004": {
      "severity": "low",
      "category": "governance",
      "title": "Sentinel policy always evaluates true"
    },
    "VT-SNT-005": {
      "severity": "low",
      "category": "governance",
      "title": "Same-named Sentinel policy differs across namespaces"
    },
    "VT-SNT-006": {
      "severity": "medium",
      "category": "governance",
      "title": "Hard-mandatory Sentinel policy always evaluates false"
    },
    "VT-SNT-007": {
      "severity": "info",
      "category": "governance",
      "title": "Sentinel policy makes outbound HTTP calls"
    }
