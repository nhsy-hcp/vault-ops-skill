    "VT-SNAP-002": {
      "severity": "medium",
      "category": "backup",
      "title": "Automated snapshot failing or overdue"
    },
    "VT-SNAP-003": {
      "severity": "info",
      "category": "backup",
      "title": "Automated snapshots stored on the node's local disk"
