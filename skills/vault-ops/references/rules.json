      "title": "No audit device enabled"
    },
    "VT-AUD-002": {
      "severity": "low",
      "category": "audit",
      "title": "Only one audit device enabled"
    },
    "VT-AUD-003": {
      "severity": "medium",
      "category": "audit",
      "title": "Audit device logs raw values or unhashed accessors"
