// vault-ops architecture: the read-only skill and the local compose dev cluster.
// Render: task docs:diagram (dot -Tpng -Gdpi=192 docs/architecture.dot -o docs/architecture.png)
//
// Palette (matches docs/skill-flow.png):
//   skill   #EEEDFE / #534AB7    script, perf  #E1F5EE / #1D9E75
//   results #FAEEDA / #BA7517    DR            #FAECE7 / #D85A30
digraph vault_ops {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", pad=0.4,
         nodesep=0.6, ranksep=0.6, newrank=true]
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
         penwidth=1.2, margin="0.25,0.12", width=2.2]
  edge  [fontname="Helvetica", fontsize=10, penwidth=1.4, arrowsize=0.7]

  subgraph cluster_session {
    label=<<FONT POINT-SIZE="11" COLOR="#534AB7"><B>CLAUDE CODE</B></FONT>>
    style="rounded,dashed"; color="#AFA9EC"; margin=16

    claude  [label=<<B>Claude + skill</B>>, fillcolor="#EEEDFE", color="#534AB7", fontcolor="#3C3489"]
    script  [label=<<B>vault_ops.py</B>>,   fillcolor="#E1F5EE", color="#0F6E56", fontcolor="#085041"]
    results [label=<<B>JSON results</B>>,   fillcolor="#FAEEDA", color="#BA7517", fontcolor="#633806", shape=note, style=filled]
  }

  subgraph cluster_vault {
    label=<<FONT POINT-SIZE="11" COLOR="#5F5E5A"><B>VAULT (compose)</B></FONT>>
    style="rounded"; color="#B4B2A9"; margin=16

    primary [label=<<B>vault-primary</B>>, fillcolor="#E1F5EE", color="#1D9E75", fontcolor="#085041", penwidth=1.8]
    pr      [label=<<B>vault-pr</B>>,      fillcolor="#E1F5EE", color="#1D9E75", fontcolor="#085041"]
    dr      [label=<<B>vault-dr</B>>,      fillcolor="#FAECE7", color="#D85A30", fontcolor="#712B13"]
  }

  claude  -> script  [color="#534AB7"]
  script  -> results [color="#BA7517"]
  results -> claude  [color="#BA7517", style=dashed, constraint=false]
  { rank=same; script; results }

  script  -> primary [label=" read-only", color="#0F6E56", fontcolor="#0F6E56"]

  { rank=same; pr; dr }
  primary -> pr [label=" perf", color="#1D9E75", fontcolor="#0F6E56"]
  primary -> dr [label=" DR",   color="#D85A30", fontcolor="#993C1D"]
}
